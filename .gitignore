# Python bytecode
__pycache__/
*.pyc
*.pyo

# Build artifacts
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/

# Linter/type-checker caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment and secrets
.env
.env.*
*.key
*.pem
*.p12
credentials.json
secrets.json

# Makefile runtime
.makefile-logs/
.makefile-pids/
.makefile-configs/*.env
!.makefile-configs/*.env.example

# Runtime files (daemon/worker PIDs, logs, heartbeats)
*/tmp/
tmp/

# Test databases
*.db
test_*.db

# Claude Code
.claude/

# Django staticfiles (generated by collectstatic)
staticfiles/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# SQLite databases (sample project, tests)
*.sqlite3
*.sqlite3-journal

# Development artifacts
.last-response
.gitignoreo
